# Copy to .env and fill in locally. .env is gitignored.
# Refresh the public schedule with:
#   node scripts/pull-schedule.mjs && node scripts/render.mjs

# Google Sheet used as the schedule source. Not published.
SCHEDULE_SHEET_URL=
SCHEDULE_RANGE=
SCHEDULE_ACCEPT_COLUMN=

# Directory of the local rETL package (the folder that contains package.json
# and src/GOOGLESHEETS.js). Not published.
RETL_ROOT=

# Path to the service-account JSON that can read the sheet and Cloud DNS.
# A file path, never the JSON itself.
GOOGLE_APPLICATION_CREDENTIALS=

# Cloud DNS project and zone for scripts/check-domain.mjs and connect-pages.mjs.
GCP_PROJECT=
DNS_ZONE=atecon-dev
